{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/open-graph/information-og",
      "destination": "/api/information-og"
    },
    {
      "source": "/open-graph/review-og",
      "destination": "/api/review-og"
    },
    {
      "source": "/log-lottery",
      "destination": "/log-lottery/index.html"
    },
    {
      "source": "/log-lottery/:path*",
      "destination": "/log-lottery/index.html"
    },
    {
      "source": "/((?!api/|log-lottery(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
